const local MAX_ENTITIES: number = 10000
const local MAX_HEALTH: number = 100
const local MIN_HEALTH: number = 0
const local DEFAULT_SPEED: number = 5
const local DEFAULT_MASS: number = 1
const local DEFAULT_FRICTION: number = 0.5

// ------------------------------------------------------------
// Basic variables
// ------------------------------------------------------------

local integer: number = 100
local decimal: number = 42.5
local smallDecimal: number = 0.125
local negative: number = -50
local booleanValue: boolean = true
local stringValue: string = "hello world"

local counter: number = 0
local accumulator: number = 0
local result: number = 0

// ------------------------------------------------------------
// Arithmetic functions
// ------------------------------------------------------------

function add(a: number, b: number): number {
    local result: number = a + b
    return result
}

function subtract(a: number, b: number): number {
    local result: number = a - b
    return result
}

function multiply(a: number, b: number): number {
    local result: number = a * b
    return result
}

function divide(a: number, b: number): number {
    local result: number = a / b
    return result
}

function power(a: number, b: number): number {
    local result: number = a ** b
    return result
}

function square(value: number): number {
    return value * value
}

function cube(value: number): number {
    return value * value * value
}

function calculate(
    a: number,
    b: number,
    c: number,
    d: number
): number {
    local first: number = a + b
    local second: number = c * d
    local third: number = first + second

    return third
}

// ------------------------------------------------------------
// Physics
// ------------------------------------------------------------

function applyGravity(
    velocity: number,
    gravityForce: number,
    dt: number
): number {
    local result: number = velocity

    result -= gravityForce * dt

    return result
}

function calculateAcceleration(
    force: number,
    mass: number
): number {
    return force / mass
}

function calculateVelocity(
    velocity: number,
    acceleration: number,
    dt: number
): number {
    local result: number = velocity

    result += acceleration * dt

    return result
}

function calculateMovement(
    position: number,
    velocity: number,
    dt: number
): number {
    local movement: number = velocity * dt

    return position + movement
}

function calculateMomentum(
    mass: number,
    velocity: number
): number {
    return mass * velocity
}

// ------------------------------------------------------------
// Entity logic
// ------------------------------------------------------------

function damageEntity(
    health: number,
    damage: number
): number {
    local newHealth: number = health

    newHealth -= damage

    if newHealth < MIN_HEALTH do {
        newHealth = MIN_HEALTH
    }

    return newHealth
}

function healEntity(
    health: number,
    amount: number
): number {
    local newHealth: number = health

    newHealth += amount

    if newHealth > MAX_HEALTH do {
        newHealth = MAX_HEALTH
    }

    return newHealth
}

function isAlive(health: number): boolean {
    if health > 0 do {
        return true
    } elseif health == 0 do {
        return false
    } else {
        return false
    }
}

function calculateDamage(
    attack: number,
    multiplier: number,
    armor: number
): number {
    local damage: number = attack * multiplier

    damage -= armor

    if damage < 0 do {
        damage = 0
    }

    return damage
}

