// ------------------------------------------------------------
// Type declarations
// ------------------------------------------------------------

export type Position = {
    x: number,
    y: number,
    z: number
}

export type Rotation = {
    pitch: number,
    yaw: number,
    roll: number
}

export type Velocity = {
    x: number,
    y: number,
    z: number
}

export type Entity = {
    id: number,
    name: string,
    active: boolean,
    position: Position,
    velocity: Velocity
}

export type Player = {
    id: number,
    name: string,
    health: number,
    speed: number,
    position: Position
}

export type Enemy = {
    id: number,
    name: string,
    health: number,
    damage: number,
    aggressive: boolean
}

export type PhysicsObject = {
    position: Position,
    velocity: Velocity,
    mass: number,
    friction: number
}

export type GameObject = Entity & PhysicsObject

export type Actor = Player | Enemy

export type Character = Player | Enemy

export type Transform = Position & Rotation

export type Numeric = number | boolean

export type Identifier = string | number

export type State = number | boolean | string

export type NestedUnion = number | string | boolean

export type NestedIntersection = Position & Rotation & Velocity

export type MixedType = Position | Rotation & Velocity

// ------------------------------------------------------------
// Generic types
// ------------------------------------------------------------

export type Container<T: number> = {
    value: T,
    index: number
}

export type Pair<A: number, B: string> = {
    first: A,
    second: B
}

export type Complex<T: number, U: string> = {
    value: T,
    name: U,
    index: number
}

