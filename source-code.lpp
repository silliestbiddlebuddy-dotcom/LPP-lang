// ------------------------------------------------------------
// More functions
// ------------------------------------------------------------

function processA(x: number): number {
    local value: number = x

    value += 10
    value *= 2
    value -= 5

    return value
}

function processB(x: number): number {
    local value: number = x

    value *= 4
    value += 20
    value /= 2

    return value
}

function processC(x: number): number {
    local value: number = x

    value -= 10
    value *= value

    return value
}

function processD(
    x: number,
    y: number
): number {
    local value: number = x + y

    value *= 2

    return value
}

function processE(
    x: number,
    y: number,
    z: number
): number {
    local value: number = x + y + z

    value *= 3
    value -= 1

    return value
}

// ------------------------------------------------------------
// Heavy nested control flow
// ------------------------------------------------------------

local stateCounter: number = 0

while stateCounter < 1000 do {
    stateCounter += 1

    if stateCounter < 100 do {
        result += 1
    } elseif stateCounter < 500 do {
        result += 2
    } elseif stateCounter < 750 do {
        result += 3
    } else {
        result += 4
    }

    if stateCounter % 2 == 0 do {
        accumulator += stateCounter
    } else {
        accumulator -= stateCounter
    }
}

// ------------------------------------------------------------
// Final calls
// ------------------------------------------------------------

local finalA: number = processA(value001)
local finalB: number = processB(value002)
local finalC: number = processC(value003)
local finalD: number = processD(value004, value005)
local finalE: number = processE(value006, value007, value008)

result += finalA
result += finalB
result += finalC
result += finalD
result += finalE

// ------------------------------------------------------------
// Global mutations
// ------------------------------------------------------------

gameTime += deltaTime

if running do {
    gameTime += deltaTime
}

if entityCount < MAX_ENTITIES do {
    entityCount += 1
}

if playerCount < entityCount do {
    playerCount += 1
}

if enemyCount < entityCount do {
    enemyCount += 1
}

// ------------------------------------------------------------
// Final values
// ------------------------------------------------------------

local finalResult: number = result
local finalCounter: number = counter
local finalAccumulator: number = accumulator
local finalTime: number = gameTime
// ------------------------------------------------------------
// Classes
// ------------------------------------------------------------

class EntityBase {
    public id: number
    public name: string
    protected active: boolean

    public function getId(): number {
        return id
    }

    public function getName(): string {
        return name
    }

    protected function setActive(value: boolean): void {
        active = value
    }
}

class PlayerCharacter {
    public id: number
    public name: string
    public health: number
    public speed: number

    private secretValue: number
    protected active: boolean

    public function getHealth(): number {
        return health
    }

    public function damage(amount: number): void {
        health -= amount

        if health < 0 do {
            health = 0
        }
    }

    public function heal(amount: number): void {
        health += amount

        if health > MAX_HEALTH do {
            health = MAX_HEALTH
        }
    }

    public function isAlive(): boolean {
        return health > 0
    }

    private function resetSecret(): void {
        secretValue = 0
    }
}

class EnemyCharacter {
    public id: number
    public name: string
    public health: number
    public damage: number
    public aggressive: boolean

    private targetId: number
    protected active: boolean

    public function attack(targetHealth: number): number {
        local newHealth: number = targetHealth

        newHealth -= damage

        if newHealth < 0 do {
            newHealth = 0
        }

        return newHealth
    }

    public function setTarget(id: number): void {
        targetId = id
    }

    public function getTarget(): number {
        return targetId
    }

    protected function deactivate(): void {
        active = false
    }
}

// ------------------------------------------------------------
// Classes with multiple methods and properties
// ------------------------------------------------------------

class PhysicsEntity {
    public position: Position
    public velocity: Velocity

    protected mass: number
    protected friction: number

    public function update(dt: number): void {
        position.x += velocity.x * dt
        position.y += velocity.y * dt
        position.z += velocity.z * dt
    }

    public function calculateMomentum(): number {
        return mass * velocity.x
    }

    protected function applyFriction(): void {
        velocity.x *= friction
        velocity.y *= friction
        velocity.z *= friction
    }
}

// ------------------------------------------------------------
// Static members
// ------------------------------------------------------------

class MathUtility {
    public static value: number

    public static function add(a: number, b: number): number {
        return a + b
    }

    public static function multiply(a: number, b: number): number {
        return a * b
    }

    private static function secretCalculation(x: number): number {
        return x * x + 10
    }
}

// ------------------------------------------------------------
// More complex class
// ------------------------------------------------------------

class GameObject {
    public id: number
    public name: string
    public position: Position
    public rotation: Rotation

    private active: boolean
    private updateCount: number

    protected velocity: Velocity
    protected mass: number

    public function update(dt: number): void {
        position.x += velocity.x * dt
        position.y += velocity.y * dt
        position.z += velocity.z * dt

        updateCount += 1
    }

    public function move(x: number, y: number, z: number): void {
        position.x += x
        position.y += y
        position.z += z
    }

    public function setVelocity(x: number, y: number, z: number): void {
        velocity.x = x
        velocity.y = y
        velocity.z = z
    }

    public function getUpdateCount(): number {
        return updateCount
    }

    public function enable(): void {
        active = true
    }

    public function disable(): void {
        active = false
    }

    public function isActive(): boolean {
        return active
    }
}

// ------------------------------------------------------------
// Classes with generic parameters
// ------------------------------------------------------------

class Container<T: number> {
    public value: T
    public index: number

    public function getValue(): T {
        return value
    }

    public function getIndex(): number {
        return index
    }
}

