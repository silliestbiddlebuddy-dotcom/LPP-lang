local logicalC: boolean = integer > 0 && booleanValue || integer < 10

// ------------------------------------------------------------
// If / elseif / else
// ------------------------------------------------------------

if integer > 100 do {
    result += 10
} elseif integer == 100 do {
    result += 20
} else {
    result += 30
}

if decimal > 50.0 do {
    result += 1
} elseif decimal > 25.0 do {
    result += 2
} else {
    result += 3
}

// ------------------------------------------------------------
// Nested conditions
// ------------------------------------------------------------

if result > 0 do {
    local nestedA: number = result * 2

    if nestedA > 100 do {
        nestedA -= 10

        if nestedA > 50 do {
            nestedA -= 5
        } elseif nestedA == 50 do {
            nestedA += 5
        } else {
            nestedA += 10
        }
    } elseif nestedA == 0 do {
        nestedA = 1
    } else {
        nestedA += 20
    }

    result = nestedA
} else {
    result = 1
}

// ------------------------------------------------------------
// While loop
// ------------------------------------------------------------

while counter < 100 do {
    counter += 1
    accumulator += counter

    if counter == 25 do {
        continue
    }

    if counter == 90 do {
        break
    }
}

// ------------------------------------------------------------
// Nested while loops
// ------------------------------------------------------------

local outerCounter: number = 0

while outerCounter < 10 do {
    local innerCounter: number = 0

    while innerCounter < 10 do {
        result += outerCounter
        result += innerCounter

        innerCounter += 1
    }

    outerCounter += 1
}

// ------------------------------------------------------------
// For loops
// ------------------------------------------------------------

for (local x: number = 0; x < 100; x += 1) do {
    result += x
}

for (local x: number = 0; x < 50; x += 1) do {
    local squared: number = x * x

    result += squared
}

for (local index: number = 0; index < 100; index += 1) do {
    local value: number = index * 2

    if value < 25 do {
        result += value
    } elseif value < 100 do {
        result -= value
    } else {
        result += value * 2
    }

    if index == 75 do {
        break
    }
}

// ------------------------------------------------------------
// Nested for loops
// ------------------------------------------------------------

for (local x: number = 0; x < 10; x += 1) do {
    for (local y: number = 0; y < 10; y += 1) do {
        local value: number = x * y

        result += value
    }
}

