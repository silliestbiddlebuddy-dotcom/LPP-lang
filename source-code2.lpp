
// ============================================================
// L++ Binder Test
// ============================================================


// ------------------------------------------------------------
// Type aliases
// ------------------------------------------------------------

type UserId = int32;

type Name = string;

type Number = int32 | float32;

type Pair = {
    first: int32,
    second: int32
};


// ------------------------------------------------------------
// Interfaces
// ------------------------------------------------------------

interface Printable<T: any> {
    value: T
    name: string
}

interface Identifiable {
    id: UserId
    label: string
}


// ------------------------------------------------------------
// Global variables
// ------------------------------------------------------------

global userId: UserId = 42;

global userName: Name = "test";

const global globalNumber: int32 = 10;


// ------------------------------------------------------------
// Generic functions
// ------------------------------------------------------------

function identity<T: any>(value: T): T {
    return value;
}

function printValue<T: Printable<T>>(value: T): T {
    return value;
}

function constrained<T: int32 | float32>(value: T): T {
    return value;
}

// ------------------------------------------------------------
// Function with nested scopes
// ------------------------------------------------------------

function testScopes(value: int32, name: string): int32 {

    local x: int32 = value;

    local text: string = name;

    if (x > 0) do {

        local insideIf: int32 = x;

        while (insideIf > 0) do {

            local insideWhile: int32 = insideIf;

            insideIf -= 1;
        }
    }

    return x;
}


// ------------------------------------------------------------
// For-loop scope
// ------------------------------------------------------------

function testLoop(): int32 {

    local total: int32 = 0;

    for (local i: int32 = 0; i < 5; i += 1) do {

        local loopValue: int32 = i;

        total += loopValue;
    }

    return total;
}


// ------------------------------------------------------------
// Classes
// ------------------------------------------------------------

class BaseClass {

    public value: int32

    public function BaseClass(start: int32): int32 {
        return start;
    }
}

class DerivedClass extends BaseClass {

    public name: string

    public function DerivedClass(start: int32, name: string): int32 {
        return start;
    }
}


// ------------------------------------------------------------
// Generic class
// ------------------------------------------------------------

class Box<T: any> {

    public value: T

    public function Box(value: T): T {
        return value;
    }

    public function get(): T {
        return value;
    }
}


// ------------------------------------------------------------
// Generic class implementing an interface
// ------------------------------------------------------------

class PrintableBox<T: any> implements Printable<T> {

    public value: T

    public name: string

    public function PrintableBox(value: T, name: string): T {
        return value;
    }

    public function get(): T {
        return value;
    }
}


// ------------------------------------------------------------
// `declare` is only a modifier.
// The parser still requires a function body.
// ------------------------------------------------------------

declare function externalFunction(value: int32): int32 {
    return value;
}


// ------------------------------------------------------------
// Shadowing
// ------------------------------------------------------------

function testShadowing(): int32 {

    local value: int32 = 10;

    if (value > 0) do {

        local value: int32 = 20;

        if (value > 10) do {

            local value: int32 = 30;

            value += 1;
        }

        value += 1;
    }

    value += 1;

    return value;
}


// ------------------------------------------------------------
// Object literal
// ------------------------------------------------------------

function createPair(): Pair {

    local pair: Pair = {
        first: 10,
        second: 20
    };

    return pair;
}


// ------------------------------------------------------------
// Main
// ------------------------------------------------------------

function main(): int32 {

    local result: int32 = identity(123);

    local pair: Pair = createPair();

    testScopes(result, "hello");

    testLoop();

    testShadowing();

    externalFunction(result);

    return result;
}
